---
layout: null
---
[
{% for post in site.posts %}
  {"type":"笔记","title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"description":{{ post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 220 | jsonify }},"tags":{{ post.tags | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
{% if site.posts.size > 0 and site.data.projects.size > 0 %},{% endif %}
{% for project in site.data.projects %}
  {"type":"项目","title":{{ project.name | jsonify }},"url":{{ '/projects/' | append: '#project-' | append: project.key | relative_url | jsonify }},"description":{{ project.description | jsonify }},"tags":{{ project.topics | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
